# Server configuration
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/ezroom
JWT_SECRET=your_jwt_secret_key_here

# Cloudinary (Image storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# PayOS Payment Gateway (Deposit & Invoices)
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key

# PayOS Payout Gateway (Host Disbursements)
PAYOS_PAYOUT_CLIENT_ID=your_payos_payout_client_id
PAYOS_PAYOUT_API_KEY=your_payos_payout_api_key
PAYOS_PAYOUT_CHECKSUM_KEY=your_payos_payout_checksum_key

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=your_admin_bcrypt_hash

# SMTP Mailer (Email notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
